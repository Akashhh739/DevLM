# ============================================================
# OpenClaw — example environment file
# cp .env.example .env  →  fill in only the sources you have
# NEVER commit .env  (it is already in .gitignore)
# ============================================================
# Rule: leave a variable BLANK (not "none"/"null") to skip that connector.
# Connectors whose required vars are blank are silently skipped — they
# return zero signals and do not error.
# ============================================================

# ------------------------------------------------------------
# REQUIRED — OpenAI (the agent brain)
# Where: platform.openai.com → API keys → Create new secret key
# Scopes: no restrictions needed (key is used server-side only)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
# Recommended models (cheapest → best):
#   gpt-4o-mini          — fast, cheap, good for testing ($0.15/1M in)
#   gpt-4.1-mini         — good balance for daily runs
#   gpt-4.1              — best reasoning, use for production analysis
#   o4-mini              — strong reasoning, moderate cost
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# REQUIRED — local paths (defaults work if you run from the repo root)
# ------------------------------------------------------------
# Where the agent reads your codebase (git blame/log/diff, file reads)
REPO_PATH=.
# Where your runbooks + infra guidelines live (plain .md files)
RULES_DIR=rules
# Where the agent writes/reads its compounding knowledge notes
MEMORY_DIR=memory
# Where Parquet snapshots are written (one folder per run)
SNAPSHOTS_DIR=snapshots

# ============================================================
# CONNECTORS — fill in the ones you actually have
# ============================================================

# ------------------------------------------------------------
# demo  (NO setup — always works)
# Use: openclaw run --sources demo
# ------------------------------------------------------------
# No variables needed. Generates synthetic signals so you can
# test the whole pipeline without real credentials.

# ------------------------------------------------------------
# loki  (Grafana Loki — raw log lines)
# Needs: a running Loki instance (local Docker or Grafana Cloud)
# Permissions: read-only; no token needed for unauthenticated Loki
# Where to get URL: Grafana Cloud → Connections → Data sources → Loki
# ------------------------------------------------------------
LOKI_URL=http://localhost:3100
# Optional — restrict query to one namespace (e.g. "production")
LOKI_NAMESPACE=

# ------------------------------------------------------------
# cloudflare  (WAF / firewall events — IP spam, blocked attacks)
# Needs: Cloudflare account with at least one zone
# Permissions (read-only token — create at dash.cloudflare.com/profile/api-tokens):
#   Zone → Firewall Services : Read
#   Zone → Logs : Read
#   Account → Account Analytics : Read
# How to find Zone ID: dash.cloudflare.com → select zone → Overview → right sidebar
# How to find Account ID: dash.cloudflare.com → any zone → Overview → right sidebar
# ------------------------------------------------------------
CLOUDFLARE_API_TOKEN=your_cloudflare_read_only_token_here
CLOUDFLARE_ZONE_ID=abcdef1234567890abcdef1234567890
# Account ID — also used by cf_workers connector below
CLOUDFLARE_ACCOUNT_ID=abcdef1234567890abcdef1234567890

# ------------------------------------------------------------
# cf_workers  (Cloudflare Workers — invocation error rates)
# Reuses CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID above.
# No extra variables needed — just fill in both Cloudflare vars.
# ------------------------------------------------------------

# ------------------------------------------------------------
# aws  (GuardDuty threat findings + CloudWatch alarms)
# Needs: pip install -e ".[aws]"
# Permissions — create a read-only IAM user/role with this policy:
#   guardduty:ListDetectors
#   guardduty:ListFindings
#   guardduty:GetFindings
#   cloudwatch:DescribeAlarms
#   (or attach the AWS managed policy: SecurityAudit)
# Where to get keys: IAM → Users → your user → Security credentials → Access keys
# Best practice: use a named profile (~/.aws/credentials) instead of inline keys
# ------------------------------------------------------------
AWS_REGION=us-east-1
# Extra CloudWatch log groups to pull (comma-separated). App Runner /application groups are auto-discovered.
CLOUDWATCH_LOG_GROUPS=
# Inline long-lived keys (only if you don't use a named profile/role):
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Or use a named profile (leave keys blank if using this):
# AWS_PROFILE=openclaw-readonly

# ------------------------------------------------------------
# apprunner  (AWS App Runner service health)
# Reuses AWS_REGION + AWS credentials above.
# No extra variables needed.
# ------------------------------------------------------------

# ------------------------------------------------------------
# github  (CI workflow failures — Actions runs)
# Needs: a GitHub PAT with read-only scopes
# Where: github.com → Settings → Developer settings → Personal access tokens → Fine-grained
# Scopes needed (fine-grained PAT):
#   Repository: Actions (read)
#   Repository: Contents (read)  ← for reading code files
#   Repository: Metadata (read)
# Or classic PAT with: repo (read), workflow
# ------------------------------------------------------------
GITHUB_TOKEN=github_pat_11AAAAAAAAA...
# Format: owner/repo (e.g. your-org/your-repo)
GITHUB_REPO=your-org/your-repo

# ------------------------------------------------------------
# supabase  (auth audit log — failed logins, suspicious actions)
# Needs: pip install -e ".[postgres]"
# Where to get the connection string:
#   Supabase dashboard → Project Settings → Database → Connection string → URI
#   Use the "Connection pooling" string for production (port 6543)
# Permissions: the default postgres user works, but ideally create a read-only role:
#   CREATE ROLE openclaw_ro WITH LOGIN PASSWORD 'your_pass';
#   GRANT CONNECT ON DATABASE postgres TO openclaw_ro;
#   GRANT USAGE ON SCHEMA auth TO openclaw_ro;
#   GRANT SELECT ON auth.audit_log_entries TO openclaw_ro;
# ------------------------------------------------------------
SUPABASE_DB_URL=postgresql://openclaw_ro:your_pass@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ------------------------------------------------------------
# postgres  (generic DB health — connections, long queries, deadlocks)
# Needs: pip install -e ".[postgres]"
# Permissions — create a dedicated monitoring role (no table data / PII):
#   CREATE ROLE watchman_ro WITH LOGIN PASSWORD 'your_pass';
#   GRANT pg_monitor TO watchman_ro;  -- gives access to pg_stat_* views
# ------------------------------------------------------------
DATABASE_URL=postgresql://watchman_ro:your_pass@localhost:5432/your_db

# ------------------------------------------------------------
# sentry  (unresolved error issues)
# Where: sentry.io → Settings → Auth Tokens → Create New Token
#   (or Settings → Developer Settings → Internal Integration for org-level)
# Scopes needed (read-only):
#   event:read
#   project:read
#   org:read
# How to find org slug: sentry.io/<org-slug>/ (the URL segment after sentry.io)
# How to find project slug: sentry.io/<org-slug>/<project-slug>/
# ------------------------------------------------------------
SENTRY_TOKEN=sntrys_eyJpYXQiOjE...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# Leave blank for sentry.io; set for self-hosted Sentry:
SENTRY_URL=

# ------------------------------------------------------------
# prometheus  (firing alerts — whatever your rules say is critical)
# Reads /api/v1/alerts — no token needed for unauthenticated Prometheus
# If behind auth, expose a read-only proxy/tunnel on a local port
# ------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090

# ------------------------------------------------------------
# kubernetes  (cluster events — CrashLoopBackOff, OOMKilled, etc.)
# Needs: pip install -e ".[k8s]"
# Permissions — create a read-only ClusterRole:
#   kubectl create clusterrolebinding openclaw-view \
#     --clusterrole=view \
#     --serviceaccount=default:openclaw
# Or point at an existing kubeconfig context (uses your current ~/.kube/config)
# ------------------------------------------------------------
KUBE_ENABLED=false
# Leave blank to use current context from ~/.kube/config
KUBE_CONTEXT=

# ------------------------------------------------------------
# dns  (DNS resolution failures — no credentials needed)
# Just list your hostnames; the stdlib resolver checks each one
# ------------------------------------------------------------
DNS_HOSTS=api.yourdomain.com,www.yourdomain.com,auth.yourdomain.com

# ------------------------------------------------------------
# ga4  (Google Analytics 4 — traffic anomalies, session drops)
# Needs: pip install -e ".[ga4]"
# Setup:
#   1. Google Cloud Console → IAM → Service Accounts → Create
#   2. Download JSON key file
#   3. GA4 Admin → Property Access Management → Add user → Viewer role
#      (use the service account email: name@project.iam.gserviceaccount.com)
# How to find Property ID: GA4 Admin → Property Settings → Property ID (numeric)
# ------------------------------------------------------------
GA4_PROPERTY_ID=123456789
# Standard Google env var — point at the downloaded JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# ------------------------------------------------------------
# loki (already listed above)
# ------------------------------------------------------------

# ============================================================
# OPTIONAL ADD-ONS (not connectors — enhance the agent)
# ============================================================

# ------------------------------------------------------------
# LangSmith — traces every run (tool calls, token cost, latency)
# Needs: pip install -e ".[trace]"
# Where: smith.langchain.com → Settings → API Keys → Create API Key
# Once set, every run appears at smith.langchain.com automatically
# ------------------------------------------------------------
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=openclaw

# ------------------------------------------------------------
# Jev pre-ranking — System-1 triage before the expensive GPT call
# Ranks which log clusters matter; no-op if key is blank
# Where: openrouter.ai → Keys → Create Key (free tier available)
# ------------------------------------------------------------
JEV_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api/v1
JEV_MODEL=typesafe/jev-1.13

# ------------------------------------------------------------
# R2 cold archive — archive old Parquet snapshots to Cloudflare R2
# Needs: pip install -e ".[archive]"
# Setup: Cloudflare R2 → Create bucket → R2 API tokens → Create token
# Token permissions: Object Read & Write (scoped to your bucket)
# Usage after setup: openclaw archive --older-than 30d [--delete-local]
# ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=openclaw-snapshots
# Leave blank — auto-derived from R2_ACCOUNT_ID:
R2_ENDPOINT=
